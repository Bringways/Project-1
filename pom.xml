<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
        Every Spring Boot app inherits from spring-boot-starter-parent.
        This parent POM is what gives us:
          - Sensible default versions for all Spring dependencies (so we don't
            have to specify a <version> for each starter below)
          - Default plugin configuration (like the Maven compiler plugin)
          - The spring-boot-maven-plugin config needed to build an executable JAR
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>devops-practice-app</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>devops-practice-app</name>
    <description>Employee Management REST API for practicing Java/Maven/Docker/CI-CD fundamentals</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Core web framework: gives us @RestController, embedded Tomcat, JSON conversion -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Data JPA: lets us talk to the database using Java interfaces instead of raw SQL -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- H2: an in-memory database, perfect for local practice (no DB server to install) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Bean Validation: powers @NotBlank, @Email, @Positive annotations on our Employee model -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Test starter: JUnit 5, Mockito, Spring Test, AssertJ - everything needed for mvn test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>devops-practice-app</finalName>
        <plugins>
            <!--
                This plugin is what turns our compiled classes into a single
                runnable "fat JAR" (target/devops-practice-app.jar) that
                contains our code PLUS an embedded Tomcat server PLUS all
                dependencies. That's why we can run it with just "java -jar".
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
